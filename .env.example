# ==============================================================
# ShipHype Environment Variables
# ==============================================================

# 1. Google Gemini API Key (Required for AI material generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Public App URL (Used for generating absolute links in emails, RSS & OG images)
# In production on Vercel: https://your-shiphype.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. GitHub Personal Access Token (Optional: Increases rate limit to 5,000 req/hr)
# Generate at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# 4. Email Broadcast Service (Optional: For sending real emails to subscribers)
# Powered by Resend (Free 3,000 emails/month). Get API key at: https://resend.com
RESEND_API_KEY=
# Sender email address. Use onboarding@resend.dev during testing, or your custom domain email
RESEND_FROM_EMAIL=onboarding@resend.dev

# 5. X / Twitter API v2 Credentials (Optional: For direct live posting to X)
# Get from: https://developer.x.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# 6. Webhook HMAC Secret (Used for authenticating GitHub release webhooks)
GITHUB_WEBHOOK_SECRET=shiphype_dev_secret
